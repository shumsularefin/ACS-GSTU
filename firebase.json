{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "public",
    "redirects": [{ "source": "/membership.html", "destination": "/index.html#membership", "type": 301 }],
    "predeploy": ["npm run build", "npm test"],
    "headers": [
      { "source": "js/**/*.mjs", "headers": [{ "key": "Content-Type", "value": "text/javascript" }] },
      { "source": "data/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
      { "source": "js/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
      { "source": "fonts/original/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
      { "source": "css/site.*.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "images/optimized/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
    ],
    "ignore": [
      "firebase.json",
      "**/*debug.log",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
